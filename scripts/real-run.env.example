# Settings for scripts/run_real_check.py. Copy this file OUTSIDE the repository, for example to
# <PRIVATE_FOLDER>\real-run.env, and replace every <...> value.
# Secrets are never written here: only the PATHS of one-line key files.
# Run: python scripts/run_real_check.py --config <PRIVATE_FOLDER>\real-run.env
# Self-test with no real service: python scripts/run_real_check.py --dry-fakes

# A new database file for this run (the folder holds the desk logs and result.json; delete it afterwards).
DESK_DB_PATH=<RUN_FOLDER>\desk.db

# HubSpot (free plan). File with one line: the service key. Scopes: contacts read and contacts write only.
DESK_HUBSPOT_KEY_FILE=<SECRETS_FOLDER>\hubspot-key.txt
# Hard cap of HubSpot calls per desk process (the run starts two: one before and one after the crash). The cap lives in
# the process's memory: a restarted process starts with a fresh cap, so the run's total is the cap times the processes.
DESK_HUBSPOT_MAX_CALLS=400
# Hard cap of HubSpot calls of this script's read-back and clean-up.
REAL_HUBSPOT_READBACK_MAX_CALLS=200
# Optional: DESK_HUBSPOT_TIMEOUT_SECONDS, DESK_HUBSPOT_MAX_429_RETRIES. The base address defaults to HUBSPOT_BASE_URL in
# src/lead_desk/constants.py; DESK_HUBSPOT_BASE_URL may name another https host of the vendor's own domains (see
# HUBSPOT_HOST_SUFFIXES there); any other host needs DESK_HUBSPOT_ALLOW_ANY_BASE_URL=yes.
# Optional (only with --live-model): the DESK_LIVE_* names with their own key file.
# A contact archived into the HubSpot recycle bin is ASSUMED to keep its email reserved (an assumption): a later run that reuses that email stops with a
# clear message (restore or permanently delete the contact in HubSpot first). The made-up emails are new in every run.

# (The addresses below are placeholders on the reserved example domain: put your own.)
# Sending: Gmail over STARTTLS on port 587 by default, certificate checked. The password file holds the Gmail app password
# of the sending account (ONE line, nothing else).
# <HOST> = the name of your mail provider's outgoing mail server (look it up in the provider's help pages).
DESK_SMTPP_HOST=<HOST>
DESK_SMTPP_USER=sender@example.com
DESK_SMTPP_PASSWORD_FILE=<SECRETS_FOLDER>\sender-app-password.txt
DESK_SMTPP_FROM=sender@example.com
# Your OWN two inboxes, comma separated: first the Gmail one, then the second one (for example a Google Workspace one).
# Each lead's mail goes to one of them (chosen by a stable hash of the lead id), so the run shows arrival at two providers.
# Made-up people are never mailed.
DESK_SMTPP_RECIPIENTS=sender@example.com,second@example.com
# Hard cap of mails per desk process (also in memory: see the HubSpot cap above).
DESK_SMTPP_MAX_SENDS=60

# Counting: one block per mailbox, in the SAME order as DESK_SMTPP_RECIPIENTS; the user of block n MUST be the n-th
# recipient (the script refuses otherwise). REAL_IMAP_n_HOST defaults to MAIL_IMAP_DEFAULT_HOST in
# src/lead_desk/constants.py (a Workspace mailbox uses the same host as a Gmail one).
# Each mailbox has its own app password file (ONE line, nothing else).
REAL_IMAP_1_USER=sender@example.com
REAL_IMAP_1_PASSWORD_FILE=<SECRETS_FOLDER>\sender-app-password.txt
REAL_IMAP_2_USER=second@example.com
REAL_IMAP_2_PASSWORD_FILE=<SECRETS_FOLDER>\second-app-password.txt
# Optional: DESK_SMTPP_PORT, DESK_SMTPP_SECURITY (starttls or ssl), DESK_SMTPP_CA_FILE, DESK_SMTPP_TIMEOUT_SECONDS,
# REAL_IMAP_n_HOST, REAL_IMAP_n_PORT, REAL_IMAP_n_CA_FILE, REAL_IMAP_n_FOLDERS (default INBOX and MAIL_SPAM_FOLDER in
# src/lead_desk/constants.py)

# Optional run shape: people (default 12, at least 8), seconds to wait for the desk, seconds to wait for mail.
# REAL_PERSONS=12
# REAL_DRAIN_SECONDS=150
# REAL_MAIL_WAIT_SECONDS=90
# REAL_MAIL_SETTLE_SECONDS=10   (after every mail is seen once, wait this long and count once more: a late second copy)
# REAL_RESULT_FILE=<RUN_FOLDER>\result.json
# DESK_PORT=8765
